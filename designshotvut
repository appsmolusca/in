    <script>
        const searchInput = document.getElementById('searchInput');
        const closeIcon = document.getElementById('closeIcon');
        const appItems = document.querySelectorAll('.app-item');
        const categories = document.querySelectorAll('.category-card');

        // Search Function
        searchInput.addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            
            if (term.length > 0) {
                closeIcon.classList.add('active');
            } else {
                closeIcon.classList.remove('active');
            }

            appItems.forEach(item => {
                const title = item.getAttribute('data-title').toLowerCase();
                if (title.includes(term)) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });

            categories.forEach(cat => {
                const visibleItems = cat.querySelectorAll('.app-item:not(.hidden)');
                if (visibleItems.length === 0) {
                    cat.classList.add('hidden');
                } else {
                    cat.classList.remove('hidden');
                }
            });
        });

        // Clear Search
        closeIcon.addEventListener('click', () => {
            searchInput.value = '';
            closeIcon.classList.remove('active');
            appItems.forEach(item => item.classList.remove('hidden'));
            categories.forEach(cat => cat.classList.remove('hidden'));
            searchInput.focus(); // Kembalikan kursor ke input setelah clear
        });

        // Shortcut '/'
        window.addEventListener('keydown', (e) => {
            if (e.key === '/' && document.activeElement !== searchInput) {
                e.preventDefault();
                searchInput.focus();
            } else if (e.key === 'Escape' && document.activeElement === searchInput) {
                searchInput.blur();
                closeIcon.click();
            }
        });
    </script>
